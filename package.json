{
  "name": "edunex-plus",
  "productName": "Edunex Plus",
  "version": "0.0.1",
  "private": true,
  "description": "Unofficial, community-built desktop client for ITB's EduNex LMS",
  "main": "dist/desktop/main.cjs",
  "scripts": {
    "postinstall": "node scripts/adhoc-sign-electron.mjs",
    "dev": "node scripts/dev.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build": "npm run typecheck && node scripts/build-desktop.mjs && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.desktop.json && tsc -p tsconfig.test.json && tsc -p tsconfig.v1.json && tsc -p tsconfig.node.json --noEmit",
    "start": "electron .",
    "test": "vitest run",
    "record": "electron scripts/record-session.cjs",
    "fixtures:scrub": "node scripts/scrub-recording.mjs",
    "package:mac": "npm run build && electron-packager . --overwrite --icon=assets/icon.icns && node scripts/adhoc-sign-electron.mjs \"Edunex Plus-darwin-arm64/Edunex Plus.app\""
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "cheerio": "^1.2.0",
    "effect": "4.0.0-rc.115",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remixicon": "^4.6.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.115",
    "@electron/packager": "^20.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.0",
    "wait-on": "^8.0.0"
  }
}
