{
  "name": "edunex-plus",
  "productName": "Edunex Plus",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "Unofficial desktop app for ITB students: Edunex and SIX in one place",
  "author": "Edunex Plus contributors",
  "homepage": "https://github.com/pablonification/edunex-plus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablonification/edunex-plus.git"
  },
  "bugs": {
    "url": "https://github.com/pablonification/edunex-plus/issues"
  },
  "keywords": [
    "itb",
    "edunex",
    "six",
    "student",
    "desktop",
    "electron"
  ],
  "desktopName": "edunex-plus.desktop",
  "main": "dist/desktop/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/adhoc-sign-electron.mjs",
    "dev": "node scripts/dev.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build": "npm run typecheck && node scripts/build-desktop.mjs && vite build && node scripts/third-party-notices.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.desktop.json && tsc -p tsconfig.test.json",
    "start": "electron .",
    "demo:build": "vite build && node scripts/demo/build.mjs",
    "demo": "npm run demo:build && node scripts/demo/run.mjs",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome ci . && npm run typecheck && npm test",
    "knip": "knip",
    "record": "electron scripts/record-session.cjs",
    "fixtures:scrub": "node scripts/scrub-recording.mjs",
    "package:mac": "npm run build && electron-builder --config electron-builder.config.mjs --mac",
    "package:win": "npm run build && electron-builder --config electron-builder.config.mjs --win",
    "package:linux": "npm run build && electron-builder --config electron-builder.config.mjs --linux",
    "check:fuses": "node scripts/package-fuses.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "1.1.24",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "cheerio": "^1.2.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "domhandler": "5.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "knip": "6.41.0",
    "playwright-core": "^1.64.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.0"
  }
}
