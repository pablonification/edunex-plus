{
  "name": "edunex-plus",
  "productName": "Edunex Plus",
  "version": "0.0.1",
  "private": true,
  "description": "Unofficial, community-built desktop client for ITB's EduNex LMS",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:node && concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "build:node": "tsc -p tsconfig.node.json",
    "build": "npm run build:node && tsc --noEmit && vite build",
    "start": "electron ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remixicon": "^4.6.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wait-on": "^8.0.0"
  }
}
