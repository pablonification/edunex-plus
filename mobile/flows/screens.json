{
  "$comment": [
    "How the phone reaches each screen the desktop inventory reads (mobile/flows/expected), as Maestro steps.",
    "mobile/scripts/flows-from-inventory.mjs puts these in front of each screen's checks in mobile/flows/data.",
    "Placeholders: {{state}} is the inventory's state ('PL3002/modules/modul-4'), {{1}} {{2}} {{3}} its parts split at '/',",
    "{{list}} the Tugas & Ujian list a Task or exam was opened from (todo, done), {{appId}}, and a value that is exactly",
    "{{demoLink}} is the link that opens the demo build in the scenario (its EDUNEX_DEMO settings as the query).",
    "'steps' run for every state; 'byState' maps a pattern on the state to the steps that run instead.",
    "'byEntry' maps a pattern on '<entry id>|<entry context>' (its day) to steps run before that entry's checks: Jadwal shows one day at a time.",
    "'relaunch': true starts the app afresh before each state (a clean way back from a detail screen).",
    "Status 'placeholder': steps written from the testID convention (PROGRESS.md Decision 8) before the screen exists;",
    "the lead replaces them with the real steps and sets status to 'ready' as each screen lands."
  ],
  "appId": "io.github.pablonification.edunexplus.demo",
  "launch": [
    {
      "clearState": "{{appId}}"
    },
    {
      "openLink": "{{demoLink}}"
    },
    {
      "extendedWaitUntil": {
        "visible": {
          "id": "tab.home"
        },
        "timeout": 120000
      }
    }
  ],
  "screens": {
    "welcome": {
      "status": "placeholder",
      "launch": [
        {
          "clearState": "{{appId}}"
        },
        {
          "openLink": "{{demoLink}}"
        }
      ],
      "steps": [
        {
          "extendedWaitUntil": {
            "visible": {
              "id": "screen.welcome"
            },
            "timeout": 60000
          }
        }
      ],
      "byState": {
        "^connected$": [
          {
            "extendedWaitUntil": {
              "visible": {
                "id": "action.connect.edunex"
              },
              "timeout": 60000
            }
          },
          {
            "tapOn": {
              "id": "action.connect.edunex"
            }
          },
          {
            "extendedWaitUntil": {
              "visible": {
                "id": "screen.welcome.connected"
              },
              "timeout": 120000
            }
          }
        ],
        "^ready$": [
          {
            "tapOn": {
              "id": "action.continue"
            }
          },
          {
            "extendedWaitUntil": {
              "visible": {
                "id": "screen.welcome.ready"
              },
              "timeout": 600000
            }
          }
        ]
      }
    },
    "first-scan": {
      "status": "ready",
      "launch": [
        {
          "clearState": "{{appId}}"
        },
        {
          "openLink": "{{demoLink}}"
        },
        {
          "extendedWaitUntil": {
            "visible": {
              "id": "(tab\\.home|screen\\.welcome)"
            },
            "timeout": 120000
          }
        }
      ],
      "steps": [
        {
          "runFlow": {
            "when": {
              "visible": {
                "id": "screen.welcome"
              }
            },
            "commands": [
              {
                "extendedWaitUntil": {
                  "visible": {
                    "id": "action.start"
                  },
                  "timeout": 60000
                }
              },
              {
                "tapOn": {
                  "id": "action.start"
                }
              },
              {
                "extendedWaitUntil": {
                  "visible": {
                    "id": "action.connect.edunex"
                  },
                  "timeout": 60000
                }
              },
              {
                "tapOn": {
                  "id": "action.connect.edunex"
                }
              },
              {
                "extendedWaitUntil": {
                  "visible": {
                    "id": "action.continue"
                  },
                  "timeout": 180000
                }
              },
              {
                "tapOn": {
                  "id": "action.continue"
                }
              },
              {
                "extendedWaitUntil": {
                  "visible": {
                    "id": "action.open"
                  },
                  "timeout": 600000
                }
              },
              {
                "tapOn": {
                  "id": "action.open"
                }
              },
              {
                "tapOn": {
                  "text": "(Allow|Izinkan)",
                  "optional": true
                }
              },
              {
                "extendedWaitUntil": {
                  "visible": {
                    "id": "screen.firstScan"
                  },
                  "timeout": 300000,
                  "optional": true
                }
              }
            ]
          }
        },
        {
          "runFlow": {
            "when": {
              "notVisible": {
                "id": "screen.firstScan"
              }
            },
            "commands": [
              {
                "tapOn": {
                  "id": "tab.more"
                }
              },
              {
                "tapOn": {
                  "id": "row.nav.settings"
                }
              },
              {
                "extendedWaitUntil": {
                  "visible": {
                    "id": "screen.settings"
                  },
                  "timeout": 30000
                }
              },
              {
                "scrollUntilVisible": {
                  "element": {
                    "id": "action.firstScan"
                  }
                }
              },
              {
                "tapOn": {
                  "id": "action.firstScan"
                }
              }
            ]
          }
        },
        {
          "extendedWaitUntil": {
            "visible": {
              "id": "screen.firstScan"
            },
            "timeout": 60000
          }
        }
      ]
    },
    "home": {
      "status": "ready",
      "steps": [
        {
          "tapOn": {
            "id": "tab.home"
          }
        },
        {
          "assertVisible": {
            "id": "screen.home"
