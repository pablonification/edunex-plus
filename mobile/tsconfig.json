{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "paths": {
      "zod": ["./node_modules/zod"],
      "cheerio": ["./node_modules/cheerio"],
      "cheerio/slim": ["./node_modules/cheerio/dist/esm/slim"],
      "domhandler": ["./node_modules/domhandler"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "phosphor-react-native/src/icons/*": ["./node_modules/phosphor-react-native/lib/typescript/icons/*"]
    }
  },
  // The three tests that read phone parts (react-native's types) are checked here, with the phone's own packages: the
  // repository's type check runs without them (tsconfig.test.json leaves the three out).
  "include": [
    "index.ts",
    "app",
    "src",
    "app.config.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../test/mobile/widget-drawings.test.tsx",
    "../test/mobile/search-services.test.ts",
    "../test/mobile/contrast.test.ts",
    "../test/mobile/phone-calendar.test.ts"
  ]
}
