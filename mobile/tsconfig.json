{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "paths": {
      "zod": ["./node_modules/zod"],
      "cheerio": ["./node_modules/cheerio"],
      "cheerio/slim": ["./node_modules/cheerio/dist/esm/slim"],
      "domhandler": ["./node_modules/domhandler"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": ["app", "src", "app.config.ts", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
