+  // Edunex Plus: an app signed again on the student's own Apple ID (Sideloadly, AltStore) often gets its App Group
+  // under another name (the team's id added to it). The names the signer really granted are in the provisioning
+  // profile inside the bundle, so the one of those that is ours is used. Before this the app and the widgets each
+  // wrote to a store of their own, and every widget and the Live Activity stayed empty.
+  public static var appGroupIdentifier: String? = grantedAppGroup(
+    wanted: Bundle.main.object(forInfoDictionaryKey: "ExpoWidgetsAppGroupIdentifier") as? String,
+    profile: Bundle.main.url(forResource: "embedded", withExtension: "mobileprovision").flatMap { try? Data(contentsOf: $0) }
+  )
+
+  /// The App Group to use: the built-in name when the profile grants it (or says nothing), else the granted one that
+  /// carries our name.
+  static func grantedAppGroup(wanted: String?, profile: Data?) -> String? {
+    guard let wanted else { return nil }
+    let granted = appGroups(inProfile: profile)
+    if granted.isEmpty || granted.contains(wanted) { return wanted }
+    let core = wanted.hasPrefix("group.") ? String(wanted.dropFirst("group.".count)) : wanted
+    return granted.filter { $0.contains(core) }.sorted().first ?? wanted
+  }
+
+  /// The App Groups a provisioning profile grants: the profile is a signed envelope around a property list.
+  static func appGroups(inProfile profile: Data?) -> [String] {
+    guard let profile,
+          let start = profile.range(of: Data("<?xml".utf8)),
+          let end = profile.range(of: Data("</plist>".utf8), in: start.lowerBound..<profile.endIndex),
+          let plist = try? PropertyListSerialization.propertyList(from: profile.subdata(in: start.lowerBound..<end.upperBound), format: nil),
+          let entitlements = (plist as? [String: Any])?["Entitlements"] as? [String: Any],
+          let groups = entitlements["com.apple.security.application-groups"] as? [String] else {
+      return []
+    }
+    return groups
+  }
+
