+        status = SecItemAdd(query.merging(fresh) { _, new in new } as CFDictionary, nil)
+      }
+      said.append("\(group ?? "first group"): \(status)")
+    }
+    if !saidWrite {
+      saidWrite = true
+      NSLog("[ExpoWidgets] keychain write (%d bytes) %@", data.count, said.joined(separator: ", "))
+    }
+  }
