+/// Edunex Plus: the widgets' data as keychain items, for an app signed without an App Group. An item goes to the
+/// process's first keychain group and to every group its profile names, so the widget extension finds it whichever
+/// of those it was signed with; reading asks every group the reader may open. Readable while the phone is locked
+/// (after its first unlock): a widget draws on the Lock Screen too.
+enum WidgetsKeychain {
+  static let service = "expo.widgets.shared"
+  static let groups: [String?] = [nil] + WidgetsStorage.keychainGroups(
+    inProfile: Bundle.main.url(forResource: "embedded", withExtension: "mobileprovision").flatMap { try? Data(contentsOf: $0) }
+  )
+  private static var saidWrite = false
+  private static var saidRead = false
+
+  private static func item(_ key: String, group: String?) -> [String: Any] {
+    var query: [String: Any] = [
+      kSecClass as String: kSecClassGenericPassword,
+      kSecAttrService as String: service,
+      kSecAttrAccount as String: key
+    ]
+    if let group {
+      query[kSecAttrAccessGroup as String] = group
+    }
+    return query
+  }
+
+  static func set(_ data: Data, forKey key: String) {
+    var said: [String] = []
+    for group in groups {
+      let query = item(key, group: group)
+      let fresh: [String: Any] = [
+        kSecValueData as String: data,
+        kSecAttrAccessible as String: kSecAttrAccessibleAfterFirstUnlock
+      ]
