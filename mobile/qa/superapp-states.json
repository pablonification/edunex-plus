{
  "about": "Every screen x every state of the demo, with the link that shows it. Read by states-shots.sh; pictured in superapp-states.md. handling: designed (its own words and shape), shared (a shared part: EmptyState, ProblemBanner, Skeleton), weak (drawn, but says less than it should), unhandled (release blocker), no-way (the demo can't show it yet; not shot), n/a (the screen has no such state; not shot).",
  "package": "io.github.pablonification.edunexplus.demo",
  "waits": {
    "start": 15,
    "screen": 3
  },
  "states": {
    "normal": {
      "query": "EDUNEX_DEMO=signed-in"
    },
    "loading": {
      "query": "EDUNEX_DEMO=signed-in&EDUNEX_DEMO_HOLD=1",
      "wait": 3
    },
    "empty": {
      "query": "EDUNEX_DEMO=signed-in&EDUNEX_DEMO_EMPTY=tasks,exams,material,alerts,grades"
    },
    "offline": {
      "query": "EDUNEX_DEMO=signed-in&EDUNEX_DEMO_OFFLINE=1",
      "prime": true,
      "wait": 10
    },
    "error": {
      "query": "EDUNEX_DEMO=signed-in&EDUNEX_DEMO_FAIL=both"
    },
    "error-first": {
      "query": "EDUNEX_DEMO=signed-in&EDUNEX_DEMO_FAIL=both&EDUNEX_DEMO_FAIL_AT=start"
    },
    "six-ended": {
      "query": "EDUNEX_DEMO=signed-in&EDUNEX_DEMO_ENDED=six"
    },
    "no-six": {
      "query": "EDUNEX_DEMO=edunex-only"
    },
    "long": {
      "query": "EDUNEX_DEMO=signed-in&EDUNEX_DEMO_LONG=1"
    }
  },
