{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["test", "src/engine", "src/core", "src/app"],
  // These two read phone code whose types reach react-native, whose globals (setTimeout returning a number) clash with Node's
  // in src/desktop. They are checked on their own, in tsconfig.test-phone.json.
  "exclude": ["test/mobile/widget-drawings.test.tsx", "test/mobile/search-services.test.ts"]
}
