{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!test/fixtures", "!package-lock.json", "!skills-lock.json", "!.agents", "!.claude", "!assets", "!dist", "!release", "!.scratch"]
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "markdown": { "formatter": { "enabled": false } },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all", "arrowParentheses": "always" }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    { "includes": ["src/**"], "plugins": ["./biome-plugins/no-em-dash-copy.grit"] },
    { "includes": ["src/core/strings/**"], "plugins": ["./biome-plugins/no-semicolon-copy.grit"] },
    { "includes": ["scripts/demo/**"], "linter": { "rules": { "performance": { "useDomNodeTextContent": "off" } } } },
    {
      "includes": ["mobile/src/**"],
      "linter": {
        "rules": { "correctness": { "noReactNativeRawText": { "level": "error", "options": { "skip": ["Meta", "Pill", "Quiet"] } } } }
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": { "level": "error", "options": { "inputComponents": ["ScoreInput", "Switch"] } }
      },
      "style": { "noNonNullAssertion": "off" },
      "correctness": { "noComponentHookFactories": "off" },
      "suspicious": { "noAssignInExpressions": "off", "noControlCharactersInRegex": "off" },
      "complexity": { "noImportantStyles": "off" }
    }
  }
}
